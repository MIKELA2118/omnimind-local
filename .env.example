# Bind to loopback only. The application rejects non-loopback bind addresses.
OMNIMIND_HOST=127.0.0.1
OMNIMIND_PORT=8765

# OmniMind starts the local Ollama service automatically when it is installed.
OMNIMIND_OLLAMA_URL=http://127.0.0.1:11434
# Optional explicit path when Ollama is installed outside its standard location.
OMNIMIND_OLLAMA_EXECUTABLE=
OMNIMIND_EMBEDDING_MODEL=nomic-embed-text
OMNIMIND_CHAT_MODEL=qwen2.5
OMNIMIND_OLLAMA_KEEP_ALIVE=1m
OMNIMIND_OLLAMA_NUM_CTX=2048
OMNIMIND_OLLAMA_NUM_PREDICT=512
OMNIMIND_OLLAMA_NUM_THREAD=4

# Updates are disabled until an HTTPS manifest and trusted Ed25519 key are configured.
OMNIMIND_UPDATE_URL=
OMNIMIND_UPDATE_PUBLIC_KEY=

# Exact DNS hosts, comma separated; aura.ge additionally permits its subdomains.
# Wildcards are not supported. Includes the Georgian grammar source at aura.ge.
OMNIMIND_ALLOWED_HOSTS=docs.python.org,fastapi.tiangolo.com,developer.mozilla.org,react.dev,typescriptlang.org,supabase.com,aura.ge

OMNIMIND_DATABASE=data/omnimind.sqlite3
OMNIMIND_LOG=logs/omnimind.log
OMNIMIND_CRAWL_INTERVAL=5.0
OMNIMIND_CRAWL_TIMEOUT=15.0
OMNIMIND_CRAWL_MAX_BYTES=1000000
OMNIMIND_CRAWL_MAX_RETRIES=2
OMNIMIND_CRAWL_MAX_CONCURRENT=2
OMNIMIND_CRAWL_QUEUE_MAX_PENDING=100
OMNIMIND_METRICS_INTERVAL=2.0
OMNIMIND_MEMORY_RETENTION_DAYS=180
OMNIMIND_TECHNICAL_LEARNING_ENABLED=true
OMNIMIND_TECHNICAL_RELEVANCE_THRESHOLD=0.35
OMNIMIND_TECHNICAL_MAX_RECORDS=500
OMNIMIND_TECHNICAL_MAX_CHUNKS_PER_PAGE=4
OMNIMIND_TECHNICAL_CHUNK_CHARS=1000
OMNIMIND_TECHNICAL_QUEUE_MAX_PENDING=50
OMNIMIND_TECHNICAL_TTL_DAYS=90
OMNIMIND_TECHNICAL_RETRY_SECONDS=300
OMNIMIND_CPU_WARNING_PERCENT=85
OMNIMIND_MEMORY_WARNING_PERCENT=85
OMNIMIND_DISK_WARNING_PERCENT=90
